// Data source for PostgreSQL
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User model with extended features
model User {
  id                            String    @id @default(cuid())
  email                         String    @unique
  phone                         String?   @unique
  name                          String?
  gender                        String?
  emailVerifiedAt               DateTime?
  phoneVerifiedAt               DateTime?
  emailVerificationOtpHash      String?
  emailVerificationOtpExpiresAt DateTime?
  emailVerificationOtpSentAt    DateTime?
  emailVerificationOtpAttempts  Int       @default(0)

  password                  String
  accounts                  Account[]
  sessions                  Session[]
  roleId                    String
  role                      Role               @relation(fields: [roleId], references: [id])
  tokenVersion              Int                @default(0)
  orders                    Order[] // Relationship to track user orders
  photoReviews              PhotoReview[]
  assignedChats             ChatConversation[] @relation("ChatAssignedTo")
  chatCustomerConversations ChatConversation[] @relation("ChatCustomer")
  createdAt                 DateTime?          @default(now()) // Timestamp for account creation
  updatedAt                 DateTime           @updatedAt // Auto-updated timestamp
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) // Timestamp for account creation
  updatedAt   DateTime         @updatedAt // Auto-updated timestamp
}

model Resource {
  id          String           @id @default(cuid())
  key         String           @unique // user, product, order
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) // Timestamp for account creation
  updatedAt   DateTime         @updatedAt // Auto-updated timestamp
}

model Action {
  id          String           @id @default(cuid())
  key         String           @unique // create, view, update, delete
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) // Timestamp for account creation
  updatedAt   DateTime         @updatedAt // Auto-updated timestamp
}

model RolePermission {
  id         String  @id @default(cuid())
  roleId     String
  resourceId String
  actionId   String
  allowed    Boolean @default(true)

  role      Role     @relation(fields: [roleId], references: [id])
  resource  Resource @relation(fields: [resourceId], references: [id])
  action    Action   @relation(fields: [actionId], references: [id])
  createdAt DateTime @default(now()) // Timestamp for account creation
  updatedAt DateTime @updatedAt // Auto-updated timestamp

  @@unique([roleId, resourceId, actionId])
}

// Category model for organizing products
model Category {
  specifications  CategorySpecification[]
  campaignTargets CampaignCategory[]
  id              String                  @id @default(cuid())
  name            String // Category name
  slug            String                  @unique // Unique slug for URL identification
  description     String? // Optional category description
  // Banner image for the category
  thumbnailId     String?
  thumbnail       Media?                  @relation(fields: [thumbnailId], references: [id], name: "categoryThumbnail")
  bannerId        String?
  banner          Media?                  @relation(fields: [bannerId], references: [id], name: "categoryBanner")
  // Self-referencing relation for subcategories
  subCategories   Category[]              @relation("ParentChild")

  // Self-referencing relation for parent category
  parentCategory Category? @relation("ParentChild", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  parentCategoryId String? // Nullable field for subcategories

  isVariation    Boolean          @default(false) // Flag to check if variations exist
  variations     VariationValue[] // Array of variations
  variationNames VariationName[]
  products       Product[] // One-to-many relationship with Product
  fullPath       String?
  createdAt      DateTime         @default(now()) // Timestamp for category creation
  updatedAt      DateTime         @updatedAt // Auto-updated timestamp

  @@index([fullPath])
}

// Variation Model (Size, Color, etc.)
model VariationName {
  id           String           @id @default(cuid())
  name         String           @unique
  categoryId   String?
  category     Category?        @relation(fields: [categoryId], references: [id])
  values       VariationValue[] // Example: "Size", "Color"
  combinations Combination[]
  createdAt    DateTime?        @default(now()) // Timestamp for category creation
  updatedAt    DateTime?        @updatedAt // Auto-updated timestamp
}

// Variation Value Model (Specific options like XL, Red, etc.)
model VariationValue {
  id          String        @id @default(cuid())
  variationId String
  variation   VariationName @relation(fields: [variationId], references: [id])
  categoryId  String? // Can be nullable if the variation is global
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  value       String // Example: "XL", "Red", "L"
  // Many-to-Many Relationship using Join Table

  combinations Combination[] // Many-to-Many Relationship using Join Table
  createdAt    DateTime?     @default(now()) // Timestamp for category creation
  updatedAt    DateTime?     @updatedAt // Auto-updated timestamp
}

model ProductCodeCounter {
  id              String @id @default(cuid())
  lastProductCode Int
}

model Media {
  id                        String             @id @default(cuid())
  url                       String
  name                      String
  displayName               String?
  host                      String
  width                     Int?
  height                    Int?
  sizeBytes                 Int?
  categoryThumbnail         Category[]         @relation(name: "categoryThumbnail")
  categoryBanner            Category[]         @relation(name: "categoryBanner")
  // Reverse relations
  productsAsThumbnail       Product[]
  photoReviews              PhotoReview[]
  chatMessages              ChatMessage[]
  ProductVariationThumbnail ProductVariation[]
  productGallery            ProductGallery[] // Explicit Many-to-Many Relation
  banner                    banner[] // Explicit Many-to-Many Relation
  heroSlides                HeroSlide[]
  supplierDocuments         SupplierDocument[] // Explicit Many-to-Many Relation
  footerLogos               ContentPage[]      @relation("ContentPageFooterLogo")
  createdAt                 DateTime           @default(now())
}

model Product {
  specifications  ProductSpecificationValue[]
  campaignTargets CampaignProduct[]
  id              String                      @id @default(cuid())
  productCode     String?                     @unique
  title           String // Product title
  slug            String                      @unique // Unique slug for URL identification
  description     String? // Optional detailed description
  categoryId      String? // Foreign key for Category
  category        Category?                   @relation(fields: [categoryId], references: [id]) // Relation to Category
  canonicalUrl    String?

  thumbnailId             String?
  thumbnail               Media?             @relation(fields: [thumbnailId], references: [id])
  videoUrl                String? // Optional video URL for the product
  videos                  ProductVideo[]
  gallery                 ProductGallery[]
  seoKeyWord              String?
  seoDescription          String?
  isFeatured              Boolean?           @default(false) // Indicates if the product is featured
  isActive                Boolean?           @default(true) // Marks if the product is active
  viewCount               Int                @default(0)
  allowOutOfStockOrder    Boolean            @default(false)
  codAvailable            Boolean?           @default(true)
  advancePaymentType      String?            @default("NONE")
  advancePaymentValueType String?            @default("FIXED")
  advancePaymentValue     Float?
  deliveryMinDays         Int?               @default(2)
  deliveryMaxDays         Int?               @default(5)
  status                  ProductStatus?     @default(ACTIVE) // Product status enumeration
  hasVariations           Boolean?           @default(false)
  google_Category_id      String?
  gender                  String?
  ageGroup                String?
  variations              ProductVariation[]
  orders                  OrderItem[]
  photoReviews            PhotoReview[]
  searchText              String?
  Purchase                PurchaseItem[]
  createdAt               DateTime           @default(now()) // Timestamp for product creation
  updatedAt               DateTime           @updatedAt // Auto-updated timestamp

  @@index([searchText])
}

// Roots can carry values directly; children are optional, reusable fields.
model Specification {
  id         String                      @id @default(cuid())
  name       String
  key        String                      @unique
  parentId   String?
  parent     Specification?              @relation("SpecificationTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   Specification[]             @relation("SpecificationTree")
  categories CategorySpecification[]
  values     ProductSpecificationValue[]
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  @@index([parentId])
}

model CategorySpecification {
  id              String        @id @default(cuid())
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  specificationId String
  specification   Specification @relation(fields: [specificationId], references: [id])
  options         String[]      @default([])
  sortOrder       Int           @default(0)

  @@unique([categoryId, specificationId])
}

model ProductSpecificationValue {
  id              String        @id @default(cuid())
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  specificationId String
  specification   Specification @relation(fields: [specificationId], references: [id])
  value           String
  sortOrder       Int           @default(0)

  @@unique([productId, specificationId])
}

model ProductVideo {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  header    String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductGallery {
  id        String @id @default(cuid())
  productId String
  mediaId   String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id])

  createdAt DateTime @default(now())
}

model ProductVariation {
  id            String   @id @default(cuid())
  productId     String? // Foreign key for Category
  product       Product? @relation(fields: [productId], references: [id], onDelete: Cascade) // Relation to Category
  sku           String
  weight        Float?
  dimensions    String?
  regularPrice  Float? // Regular price of the product
  discountPrice Float? // Optional discount price
  thumbnailId   String?
  thumbnail     Media?   @relation(fields: [thumbnailId], references: [id])
  matcherId     String

  combinations      Combination[] // Many-to-Many Relationship using Join Table
  orders            OrderItem[]
  purchases         PurchaseItem[]
  goodsReceiptItems GoodsReceiptItem[]
  transactions      InventoryTransaction[]
  stocks            Stock[]
  deliveryItems     DeliveryItem[]
  returnItems       ReturnReceiptItem[]
}

// A campaign is a time-bound, server-evaluated promotion. Prices are never
// trusted from the browser; checkout recalculates the active campaign.
model Campaign {
  id                 String             @id @default(cuid())
  name               String
  description        String?
  group              String             @default("PRODUCT_DISCOUNT") // PRODUCT_DISCOUNT, CART_DISCOUNT, DELIVERY_DISCOUNT, PAYMENT_DISCOUNT, COUPON, COMBO
  type               String             @default("PRODUCT_DISCOUNT") // PRODUCT_DISCOUNT, DELIVERY, COUPON
  status             String             @default("DRAFT") // DRAFT or PUBLISHED
  bannerUrl          String?
  startAt            DateTime?
  endAt              DateTime?
  discountType       String? // PERCENT or FIXED
  discountValue      Float?
  specialPrice       Float?
  maxDiscountAmount  Float?
  minimumQuantity    Int?
  stackable          Boolean            @default(false)
  exclusive          Boolean            @default(false)
  discountBase       String? // PRODUCT_SUBTOTAL or ELIGIBLE_SUBTOTAL
  deliveryZone       String?
  shippingMethod     String?
  terms              String?
  cashbackType       String?
  configuration      Json?
  minimumOrderAmount Float?
  paymentMethod      String?
  paymentMethods     String[]           @default([])
  couponCode         String?
  usageLimit         Int?
  perCustomerLimit   Int?
  priority           Int                @default(0)
  createdBy          String?
  updatedBy          String?
  products           CampaignProduct[]
  categories         CampaignCategory[]
  usages             CampaignUsage[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status, startAt, endAt])
  @@index([type, status])
  @@index([couponCode])
}

model CampaignProduct {
  id         String   @id @default(cuid())
  campaignId String
  productId  String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([campaignId, productId])
  @@index([productId])
}

model CampaignCategory {
  id         String   @id @default(cuid())
  campaignId String
  categoryId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([campaignId, categoryId])
  @@index([categoryId])
}

model CampaignUsage {
  id          String   @id @default(cuid())
  campaignId  String
  orderId     String
  customerKey String?
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([campaignId, orderId])
  @@index([campaignId, customerKey])
}

model Combination {
  id                 String           @id @default(cuid())
  productVariationId String
  productVariation   ProductVariation @relation(fields: [productVariationId], references: [id], onDelete: Cascade)
  variationNameId    String?
  variationName      VariationName?   @relation(fields: [variationNameId], references: [id])
  variationValueId   String?
  variationValue     VariationValue?  @relation(fields: [variationValueId], references: [id])
  orderItems         OrderItem[] // Relationship to OrderItem
  // Additional fields can be added as needed
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Order {
  id                        String           @id @default(cuid())
  orderNo                   String           @unique
  orderItems                OrderItem[]
  campaignUsages            CampaignUsage[]
  userId                    String? // Foreign key for User
  user                      User?            @relation(fields: [userId], references: [id]) // Relation to User
  customerName              String
  phoneNumber               String
  email                     String
  orderPrice                Float // Price of the product at the time of order
  subtotal                  Float            @default(0)
  productDiscount           Float            @default(0)
  comboDiscount             Float            @default(0)
  cartDiscount              Float            @default(0)
  couponDiscount            Float            @default(0)
  paymentDiscount           Float            @default(0)
  deliveryDiscount          Float            @default(0)
  cashbackAmount            Float            @default(0)
  appliedCampaignIds        String[]         @default([])
  appliedCampaignNames      String[]         @default([])
  appliedCampaignBreakdown  Json?
  viewedBy                  String[]         @default([])
  fraudRiskScore            Int?
  fraudRiskLevel            String?
  fraudRiskFactors          Json?
  appliedCouponCode         String?
  orderWeight               Float?
  adminDiscount             Float?
  adminNote                 String?
  taxAmount                 Float?
  cancelReason              String?
  cancelReasonType          String?
  deliveryCharge            Float
  city                      String?
  thana                     String?
  deliveryAddress           String
  deliveryArea              String?
  paymentMethod             PaymentMethod? // Address for product delivery
  paymentStatus             PaymentStatus    @default(UNPAID)
  paidAmount                Float            @default(0)
  dueAmount                 Float?
  note                      String?
  status                    OrderStatus      @default(PENDING) // Order status enumeration
  customerConfirmedAt       DateTime?
  shipping                  Shipping?
  selectedPaymentGatewayId  String?
  selectedPaymentGateway    PaymentGateway?  @relation("OrderPaymentGateway", fields: [selectedPaymentGatewayId], references: [id])
  selectedCourierProviderId String?
  selectedCourierProvider   CourierProvider? @relation("OrderCourierProvider", fields: [selectedCourierProviderId], references: [id])
  timeline                  OrderTimeline[]
  payments                  Payment[]
  refunds                   Refund[]
  ledgers                   Ledger[]
  deliveries                Delivery[]
  returnReceipts            ReturnReceipt[]
  fbc                       String?
  fbp                       String?
  gclid                     String?
  ttclid                    String
  userAgent                 String?
  ipAddress                 String?
  createdAt                 DateTime         @default(now()) // Timestamp for order placement
  updatedAt                 DateTime         @updatedAt // Auto-updated timestamp

  @@index([selectedPaymentGatewayId])
  @@index([selectedCourierProviderId])
  @@index([phoneNumber, createdAt])
  @@index([ipAddress, createdAt])
}

model OrderItem {
  id               String              @id @default(cuid())
  orderId          String
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNo          String
  orderItemNo      Int
  productName      String
  campaignName     String?
  campaignDiscount Float               @default(0)
  sku              String
  productCode      String?
  thumbnail        String?
  price            Float
  quantity         Int // Foreign key for Product
  productId        String
  product          Product             @relation(fields: [productId], references: [id]) // Relation to Product
  combinations     String? // JSON string to store combination details
  combinationId    String?
  combination      Combination?        @relation(fields: [combinationId], references: [id])
  variationId      String
  variation        ProductVariation    @relation(fields: [variationId], references: [id])
  deliveryItems    DeliveryItem[]
  returnItems      ReturnReceiptItem[]
  photoReview      PhotoReview?
  status           OrderStatus         @default(PENDING)
  createdAt        DateTime            @default(now()) // Timestamp for order placement
  updatedAt        DateTime            @updatedAt // Auto-updated timestamp
}

model OrderCounter {
  id              String @id @default(cuid())
  idNo            Int    @unique
  lastOrderNumber Int
}

model OrderPushSubscription {
  id           String   @id @default(cuid())
  userId       String
  endpoint     String   @unique
  subscription Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Counter {
  id String @id @default(cuid())

  name String @unique // SUPPLIER, PRODUCT, PURCHASE_ORDER

  prefix String?

  nextValue Int

  padding Int @default(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shipping {
  id                     String           @id @default(cuid())
  orderId                String           @unique
  order                  Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNo                String?
  cn                     String?
  courierName            String?
  courierProviderId      String?
  courierProvider        CourierProvider? @relation(fields: [courierProviderId], references: [id])
  isManualEntry          Boolean          @default(false)
  deliveryFee            Float?
  cod                    Float?
  codCollectedAt         DateTime?
  codCollectedAmount     Float?
  codCollectionReference String?
  estimatedDelivery      DateTime?
  createdAt              DateTime         @default(now()) // Timestamp for order placement
  updatedAt              DateTime         @updatedAt // Auto-updated timestamp

  @@index([courierProviderId])
}

model PaymentGateway {
  id                   String        @id @default(cuid())
  name                 String
  code                 String        @unique
  adapterKey           String        @default("MANUAL")
  isActive             Boolean       @default(false)
  sortOrder            Int           @default(0)
  moneyAccountId       String?
  moneyAccount         MoneyAccount? @relation(fields: [moneyAccountId], references: [id])
  encryptedCredentials String?
  credentialVersion    Int           @default(1)
  credentialsUpdatedAt DateTime?
  nonSecretConfig      Json?
  orders               Order[]       @relation("OrderPaymentGateway")
  payments             Payment[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdBy            String?
  updatedBy            String?

  @@index([isActive, sortOrder])
  @@index([moneyAccountId])
}

model CourierProvider {
  id                    String               @id @default(cuid())
  name                  String
  code                  String               @unique
  adapterKey            String               @default("MANUAL")
  isActive              Boolean              @default(false)
  sortOrder             Int                  @default(0)
  moneyAccountId        String?
  moneyAccount          MoneyAccount?        @relation(fields: [moneyAccountId], references: [id])
  encryptedCredentials  String?
  credentialVersion     Int                  @default(1)
  credentialsUpdatedAt  DateTime?
  nonSecretConfig       Json?
  webhookLastReceivedAt DateTime?
  orders                Order[]              @relation("OrderCourierProvider")
  shippings             Shipping[]
  pickupPoints          CourierPickupPoint[]
  payments              Payment[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  createdBy             String?
  updatedBy             String?

  @@index([isActive, sortOrder])
  @@index([moneyAccountId])
}

// One database-backed configuration row controls browser pixels and
// server-side conversion APIs. Access tokens/secrets are stored together in
// encryptedSecrets; they are never returned with public storefront settings.
model SocialTrackingSetting {
  id                        String    @id
  facebookPixelId           String?
  googleTagId               String?
  googleAnalyticsId         String?
  googleAnalyticsPropertyId String?
  clarityProjectId          String?
  tiktokPixelId             String?
  encryptedSecrets          String?
  secretsUpdatedAt          DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  createdBy                 String?
  updatedBy                 String?
}

model OrderTimeline {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderNo String

  status OrderStatus

  title   String
  message String?

  location  String? // warehouse / city / courier hub
  createdBy String? // admin / system / courier

  createdAt DateTime @default(now())
}

enum PaymentMethod {
  ONLINE
  EMI
  COD
  CASH
  BANK
}

model Payment {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  transactionId     String?
  bankTransactionId String?

  gateway       String
  paymentMethod PaymentMethod?

  paymentGatewayId  String?
  paymentGateway    PaymentGateway?  @relation(fields: [paymentGatewayId], references: [id])
  courierProviderId String?
  courierProvider   CourierProvider? @relation(fields: [courierProviderId], references: [id])
  moneyAccountId    String?
  moneyAccount      MoneyAccount?    @relation(fields: [moneyAccountId], references: [id])

  amount      Float
  storeAmount Float?
  status      PaymentStatus @default(PENDING)

  currency String  @default("BDT")
  cardType String?

  cardNo          String?
  cardIssuer      String?
  cardBrand       String?
  gatewayResponse Json?

  paidAt          DateTime?
  postedAt        DateTime?
  externalEventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds           Refund[]
  ledgers           Ledger[]
  moneyTransactions MoneyTransaction[]

  @@index([paymentGatewayId])
  @@index([courierProviderId])
  @@index([moneyAccountId])
  @@index([transactionId])
  @@index([externalEventId])
}

enum RefundStatus {
  PENDING
  APPROVED
  COMPLETED
  FAILED
  CANCELLED
}

model Refund {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  returnReceiptId String?
  returnReceipt   ReturnReceipt? @relation(fields: [returnReceiptId], references: [id], onDelete: SetNull)

  paymentId      String?
  payment        Payment?      @relation(fields: [paymentId], references: [id])
  moneyAccountId String?
  moneyAccount   MoneyAccount? @relation(fields: [moneyAccountId], references: [id])

  refundDestinationType    String?
  refundDestinationDetails String?

  amount Float

  reason    String?
  adminNote String?

  status RefundStatus @default(PENDING)

  externalReference String?

  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moneyTransactions MoneyTransaction[]

  @@index([moneyAccountId])
  @@index([externalReference])
  @@index([returnReceiptId])
}

model Ledger {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  type LedgerType

  direction LedgerDirection

  amount Float

  description String?

  reference String?

  createdBy String?

  createdAt DateTime @default(now())
}

model CourierPickupPoint {
  id                String           @id @default(cuid())
  name              String
  address           String
  storeId           String?
  courierName       String?
  courierProviderId String?
  courierProvider   CourierProvider? @relation(fields: [courierProviderId], references: [id])
  phoneNumber       String?
  email             String?
  createdAt         DateTime         @default(now()) // Timestamp for order placement
  updatedAt         DateTime         @updatedAt // Auto-updated timestamp

  @@index([courierProviderId])
}

model SiteSetting {
  id                    String   @id @default(cuid())
  name                  String?
  slogan                String?
  seoTitle              String?
  seoDescription        String?
  logo                  String?
  favicon               String?
  phoneNumber1          String?
  phoneNumber2          String?
  adress1               String?
  adress2               String?
  googleMap             String?
  email                 String?
  fbLink                String?
  messengerLink         String?
  whatsappNumber        String?
  youTubeLink           String?
  primaryColor          String?
  secondaryColor        String?
  accentColor           String?
  lightBackground       String?
  lightSurface          String?
  lightText             String?
  darkBackground        String?
  darkSurface           String?
  darkText              String?
  baseFontSize          Int?
  borderRadius          Int?
  orderReconfirmEnabled Boolean  @default(true)
  orderReconfirmMessage String?  @db.VarChar(500)
  createdAt             DateTime @default(now()) // Timestamp for order placement
  updatedAt             DateTime @updatedAt // Auto-updated timestamp
}

model SocialAuthConfiguration {
  id                   String   @id @default(cuid())
  provider             String   @unique
  isActive             Boolean  @default(false)
  encryptedCredentials String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ContentPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(true)
  footerLogoId    String?
  footerLogo      Media?   @relation("ContentPageFooterLogo", fields: [footerLogoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  @@index([isPublished, slug])
}

model Notice {
  id        String    @id @default(cuid())
  notice    String?
  start     DateTime?
  end       DateTime?
  createdAt DateTime  @default(now()) // Timestamp for order placement
  updatedAt DateTime  @updatedAt // Auto-updated timestamp
}

model banner {
  id          String   @id @default(cuid())
  thumbnailId String?
  thumbnail   Media?   @relation(fields: [thumbnailId], references: [id])
  name        String?
  createdAt   DateTime @default(now()) // Timestamp for order placement
  updatedAt   DateTime @updatedAt
}

// Home slider is separate from the legacy single banner so the old banner can
// remain available without being rendered on the storefront.
model HeroSlide {
  id        String           @id @default(cuid())
  title     String?
  link      String?
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  motion    HeroSlideMotion? @default(FADE)
  imageId   String
  image     Media            @relation(fields: [imageId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([isActive, sortOrder])
}

enum HeroSlideMotion {
  FADE
  ZOOM
  SLIDE_LEFT
  SLIDE_RIGHT
}

model PhotoReview {
  id           String     @id @default(cuid())
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageId      String?
  image        Media?     @relation(fields: [imageId], references: [id], onDelete: Restrict)
  orderItemId  String?    @unique
  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerName String?
  reviewText   String?    @db.VarChar(1000)
  rating       Int?
  isPublished  Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([productId, isPublished, sortOrder])
  @@index([imageId])
  @@index([userId, createdAt])
}

// Enumeration for order status
enum OrderStatus {
  PENDING
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERY_FAILED
  FAILED_RETURNING
  FAILED_RETURN_RECEIVED
  DELIVERED
  CANCELLED
  RETURNING
  RETURNED
  REFUNDING
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  DELETED
}

enum LedgerType {
  PAYMENT
  REFUND
  DELIVERY_CHARGE
  DISCOUNT
  ADJUSTMENT
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

// Enumeration for user roles
// enum Role {
//   USER 
//   ADMIN
// }

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Supplier {
  id String @id @default(cuid())

  supplierCode String? @unique

  companyName String
  contactName String?

  phone String?
  email String?

  address String?
  city    String?
  country String?

  tradeLicense   String?
  tin            String?
  bin            String?
  notes          String?
  openingBalance Float   @default(0)

  documents SupplierDocument[]
  isActive  Boolean            @default(true)

  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyName])
  @@index([phone])
  @@index([isActive])
}

model SupplierDocument {
  id         String @id @default(cuid())
  supplierId String
  mediaId    String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  media    Media    @relation(fields: [mediaId], references: [id])

  createdAt DateTime @default(now())
}

enum SupplierStatus {
  ACTIVE

  INACTIVE
}

model PurchaseOrder {
  id String @id @default(cuid())

  poNo String @unique

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  status PurchaseStatus @default(DRAFT)

  subtotal Float

  discount Float @default(0)

  vat Float @default(0)

  shippingCost Float @default(0)

  total Float

  paidAmount Float @default(0)

  dueAmount Float

  expectedDate DateTime?

  notes String?

  items PurchaseItem[]

  receipts         GoodsReceipt[]
  supplierPayments SupplierPayment[]
  expenses         Expense[]
  createdAt        DateTime          @default(now())

  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([supplierId, status])
  @@index([createdAt])
}

model PurchaseItem {
  id String @id @default(cuid())

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variationId String
  variation   ProductVariation @relation(fields: [variationId], references: [id])

  quantity Float

  unitCost Float

  discount Float @default(0)

  total Float

  receivedQty Float @default(0)

  createdAt DateTime @default(now())

  @@index([purchaseOrderId])
  @@index([variationId])
}

model Warehouse {
  id String @id @default(cuid())

  code String @unique

  name String

  address String?

  phone String?

  manager String?

  isDefault Boolean @default(false)

  stocks Stock[]

  transactions InventoryTransaction[]
  goodsReceipt GoodsReceipt[]
  deliveries   Delivery[]
  returnItems  ReturnReceiptItem[]
  createdAt    DateTime               @default(now())

  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
}

model GoodsReceipt {
  id String @id @default(cuid())

  grnNo String @unique

  purchaseOrderId String

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  warehouseId String

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  status ReceiptStatus @default(PENDING)

  items GoodsReceiptItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([purchaseOrderId])
  @@index([warehouseId, createdAt])
}

model GoodsReceiptItem {
  id String @id @default(cuid())

  goodsReceiptId String?

  goodsReceipt GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  variationId String

  variation ProductVariation @relation(fields: [variationId], references: [id])

  batchNumber String? @unique

  supplierLotNumber String?

  quantity Float

  deliveredQuantity Float @default(0)

  deliveryItems DeliveryItem[]

  @@index([goodsReceiptId])
  @@index([supplierLotNumber])
}

model Delivery {
  id          String         @id @default(cuid())
  deliveryNo  String         @unique
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id])
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  status      DeliveryStatus @default(PACKED)
  note        String?
  deliveredAt DateTime?
  items       DeliveryItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   String?
  updatedBy   String?

  @@index([orderId, createdAt])
  @@index([warehouseId, createdAt])
}

model DeliveryItem {
  id                 String           @id @default(cuid())
  deliveryId         String
  delivery           Delivery         @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItemId        String
  orderItem          OrderItem        @relation(fields: [orderItemId], references: [id])
  goodsReceiptItemId String
  goodsReceiptItem   GoodsReceiptItem @relation(fields: [goodsReceiptItemId], references: [id])
  variationId        String
  variation          ProductVariation @relation(fields: [variationId], references: [id])
  quantity           Float

  @@index([deliveryId])
  @@index([orderItemId])
  @@index([goodsReceiptItemId])
}

model ReturnReceipt {
  id          String              @id @default(cuid())
  orderId     String
  order       Order               @relation(fields: [orderId], references: [id])
  reasonType  ReturnReasonType
  description String?
  items       ReturnReceiptItem[]
  expenses    Expense[]
  refunds     Refund[]
  createdAt   DateTime            @default(now())
  createdBy   String?

  @@index([orderId, createdAt])
}

model ReturnReceiptItem {
  id              String            @id @default(cuid())
  returnReceiptId String
  returnReceipt   ReturnReceipt     @relation(fields: [returnReceiptId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem         @relation(fields: [orderItemId], references: [id])
  variationId     String
  variation       ProductVariation  @relation(fields: [variationId], references: [id])
  warehouseId     String
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id])
  quantity        Float
  disposition     ReturnDisposition

  @@index([orderItemId])
}

model InventoryTransaction {
  id String @id @default(cuid())

  variationId String
  variation   ProductVariation @relation(fields: [variationId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  type InventoryType

  quantity Float

  balanceAfter Float

  referenceType InventoryReference

  referenceId String?

  remarks String?

  createdAt DateTime @default(now())
  createdBy String?

  @@index([warehouseId, variationId, createdAt])
  @@index([referenceType, referenceId])
}

model Stock {
  id String @id @default(cuid())

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  variationId String
  variation   ProductVariation @relation(fields: [variationId], references: [id])

  quantity Float @default(0)

  reserved Float @default(0)

  available Float @default(0)

  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([warehouseId, variationId])
}

model ExpenseCategory {
  id String @id @default(cuid())

  name String @unique

  expenses  Expense[]
  createdBy String?
  updatedBy String?
}

model Expense {
  id String @id @default(cuid())

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])

  amount Float

  description String?

  expenseDate DateTime

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  returnReceiptId String?
  returnReceipt   ReturnReceipt? @relation(fields: [returnReceiptId], references: [id])

  paymentMethod String?

  moneyAccountId    String?
  moneyAccount      MoneyAccount?      @relation(fields: [moneyAccountId], references: [id])
  moneyTransactions MoneyTransaction[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedBy String?

  @@index([categoryId, expenseDate])
  @@index([moneyAccountId, expenseDate])
  @@index([purchaseOrderId])
}

model SupplierPayment {
  id String @id @default(cuid())

  supplierId String

  supplier Supplier @relation(fields: [supplierId], references: [id])

  purchaseOrderId String?

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  moneyAccountId    String?
  moneyAccount      MoneyAccount?      @relation(fields: [moneyAccountId], references: [id])
  moneyTransactions MoneyTransaction[]

  amount Float

  paymentMethod String

  reference String?

  paidAt DateTime

  createdAt DateTime @default(now())
  createdBy String?
  updatedBy String?

  @@index([supplierId, paidAt])
  @@index([purchaseOrderId])
  @@index([moneyAccountId, paidAt])
}

model FinancialAccount {
  id        String               @id @default(cuid())
  code      String               @unique
  name      String
  type      FinancialAccountType
  isActive  Boolean              @default(true)
  lines     JournalLine[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([type, isActive])
}

model MoneyAccount {
  id                   String             @id @default(cuid())
  name                 String
  type                 MoneyAccountType
  accountNumber        String?
  balance              Float              @default(0)
  isActive             Boolean            @default(true)
  incomingTransactions MoneyTransaction[] @relation("MoneyTransactionTo")
  outgoingTransactions MoneyTransaction[] @relation("MoneyTransactionFrom")
  supplierPayments     SupplierPayment[]
  expenses             Expense[]
  paymentGateways      PaymentGateway[]
  courierProviders     CourierProvider[]
  payments             Payment[]
  refunds              Refund[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  createdBy            String?
  updatedBy            String?

  @@index([type, isActive])
}

enum MoneyAccountType {
  CASH
  BANK
  MOBILE_FINANCIAL
  PAYMENT_GATEWAY
  COURIER
}

model MoneyTransaction {
  id                String               @id @default(cuid())
  transactionNo     String               @unique
  type              MoneyTransactionType
  amount            Float
  fromAccountId     String?
  fromAccount       MoneyAccount?        @relation("MoneyTransactionFrom", fields: [fromAccountId], references: [id])
  toAccountId       String?
  toAccount         MoneyAccount?        @relation("MoneyTransactionTo", fields: [toAccountId], references: [id])
  shareholderId     String?
  shareholder       Shareholder?         @relation(fields: [shareholderId], references: [id])
  supplierPaymentId String?
  supplierPayment   SupplierPayment?     @relation(fields: [supplierPaymentId], references: [id])
  expenseId         String?
  expense           Expense?             @relation(fields: [expenseId], references: [id])
  paymentId         String?
  payment           Payment?             @relation(fields: [paymentId], references: [id])
  refundId          String?
  refund            Refund?              @relation(fields: [refundId], references: [id])
  idempotencyKey    String?
  reference         String?
  note              String?
  transactionDate   DateTime             @default(now())
  createdAt         DateTime             @default(now())
  createdBy         String?

  @@index([fromAccountId, transactionDate])
  @@index([toAccountId, transactionDate])
  @@index([shareholderId, transactionDate])
  @@index([supplierPaymentId])
  @@index([expenseId])
  @@index([paymentId])
  @@index([refundId])
  @@index([idempotencyKey])
}

model Shareholder {
  id              String             @id @default(cuid())
  name            String
  phone           String?
  email           String?
  address         String?
  sharePercentage Float?
  isActive        Boolean            @default(true)
  transactions    MoneyTransaction[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdBy       String?
  updatedBy       String?

  @@index([isActive, name])
}

enum MoneyTransactionType {
  FUND_ADD
  CUSTOMER_PAYMENT
  TRANSFER
  WITHDRAWAL
  SUPPLIER_PAYMENT
  EXPENSE
  REFUND
  PROVIDER_FEE
}

model FinancialYear {
  id        String             @id @default(cuid())
  name      String             @unique
  startDate DateTime
  endDate   DateTime
  isClosed  Boolean            @default(false)
  periods   AccountingPeriod[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([startDate, endDate])
}

model AccountingPeriod {
  id              String                 @id @default(cuid())
  financialYearId String
  financialYear   FinancialYear          @relation(fields: [financialYearId], references: [id])
  name            String
  startDate       DateTime
  endDate         DateTime
  status          AccountingPeriodStatus @default(OPEN)
  closedAt        DateTime?
  closedBy        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([financialYearId, name])
  @@index([startDate, endDate, status])
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

model JournalEntry {
  id            String              @id @default(cuid())
  entryNo       String              @unique
  entryDate     DateTime
  description   String
  referenceType AccountingReference
  referenceId   String?
  status        JournalStatus       @default(POSTED)
  lines         JournalLine[]
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([entryDate])
  @@index([referenceType, referenceId])
}

model JournalLine {
  id             String           @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry     @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        FinancialAccount @relation(fields: [accountId], references: [id])
  debit          Float            @default(0)
  credit         Float            @default(0)
  memo           String?

  @@index([journalEntryId])
  @@index([accountId])
}

enum FinancialAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountingReference {
  OPENING
  GOODS_RECEIPT
  SUPPLIER_PAYMENT
  EXPENSE
  SALE
  CUSTOMER_PAYMENT
  REFUND
  ADJUSTMENT
  FUND_ADD
  ACCOUNT_TRANSFER
  WITHDRAWAL
}

enum JournalStatus {
  POSTED
  VOID
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ReceiptStatus {
  PENDING
  COMPLETED
}

enum DeliveryStatus {
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReturnReasonType {
  DELIVERY_FAIL
  CUSTOMER_RETURN
}

enum ReturnDisposition {
  RESTOCK
  DISPOSE
}

enum InventoryType {
  IN
  OUT
  RETURN_IN
  RETURN_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum InventoryReference {
  PURCHASE
  SALE
  RETURN
  TRANSFER
  ADJUSTMENT
  OPENING
}

model AbandonedCheckoutLead {
  id              String   @id @default(cuid())
  phoneNumber     String   @unique
  customerName    String?
  district        String?
  thana           String?
  deliveryAddress String?
  email           String?
  note            String?
  deliveryArea    String?
  items           Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastSeenAt      DateTime @default(now())

  @@index([updatedAt])
}

enum ChatChannel {
  WEBSITE
  WHATSAPP
  MESSENGER
  INSTAGRAM
  TIKTOK
}

enum ChatConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum ChatMessageDirection {
  INBOUND
  OUTBOUND
}

enum ChatMessageAuthorType {
  CUSTOMER
  AGENT
  AI
  SYSTEM
}

model ChatConversation {
  id               String                 @id @default(cuid())
  channel          ChatChannel
  externalUserId   String
  customerName     String?
  customerPhone    String?
  customerUserId   String?
  customerUser     User?                  @relation("ChatCustomer", fields: [customerUserId], references: [id], onDelete: SetNull)
  preferredAddress String?
  normalizedPhone  String?
  profilePicUrl    String?
  status           ChatConversationStatus @default(OPEN)
  assignedToId     String?
  assignedTo       User?                  @relation("ChatAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastMessageAt    DateTime               @default(now())
  unreadCount      Int                    @default(0)
  aiModeEnabled    Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  messages         ChatMessage[]

  @@unique([channel, externalUserId])
  @@index([status, lastMessageAt])
  @@index([channel, status, lastMessageAt])
  @@index([normalizedPhone, lastMessageAt])
  @@index([assignedToId, status])
  @@index([customerUserId])
}

model ChatMessage {
  id                  String                @id @default(cuid())
  conversationId      String
  conversation        ChatConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel             ChatChannel
  direction           ChatMessageDirection
  authorType          ChatMessageAuthorType
  authorId            String?
  content             String                @db.Text
  externalMessageId   String?
  aiReplyForMessageId String?               @unique
  mediaId             String?
  media               Media?                @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  deliveryStatus      String                @default("RECEIVED")
  metadata            Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([channel, externalMessageId])
  @@index([conversationId, createdAt])
  @@index([mediaId])
}

model ChatSetting {
  id                   String   @id
  websiteChatEnabled   Boolean  @default(true)
  whatsappEnabled      Boolean  @default(false)
  messengerEnabled     Boolean  @default(false)
  instagramEnabled     Boolean  @default(false)
  tiktokEnabled        Boolean  @default(false)
  aiAutoReplyEnabled   Boolean  @default(false)
  welcomeMessage       String   @default("আসসালামু আলাইকুম! কীভাবে সাহায্য করতে পারি?")
  quickReplies         Json     @default("[]")
  encryptedCredentials String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdBy            String?
  updatedBy            String?
}
