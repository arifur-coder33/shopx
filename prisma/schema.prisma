datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}



model User {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  email   String   @unique
  number  String   @unique
  name    String?
  role    Role @default(USER)


}

model Category {
    id      String @id @default(auto()) @map("_id") @db.ObjectId
  name String 
  slug String @unique
  products Product[]
}

model Product{
    id  String @id @default(auto()) @map("_id") @db.ObjectId
  title String 
  slug  String @unique
  categoryId String @db.ObjectId
  category  Category @relation(fields: [categoryId], references: [id])
  regularPrice  Float
  discountPrice  Float?
  color   String
  size    String
  insideDhaka Float?
  outSideDhaka Float?
  weight  Float
  orders Order[]

}

model Order{
      id  String @id @default(auto()) @map("_id") @db.ObjectId
      productId String @db.ObjectId
        product  Product @relation(fields: [productId], references: [id])
      orderPrice Float
      deliveryCharge Float
      deliveryAddress String
    
}




enum Role {
  USER 
  ADMIN
}