  type InventoryType

  quantity Float

  balanceAfter Float

  referenceType InventoryReference

  referenceId String?

  remarks String?

  createdAt DateTime @default(now())
  createdBy String?

  @@index([storeId, warehouseId, variationId, createdAt])
  @@index([referenceType, referenceId])
}

model Stock {
