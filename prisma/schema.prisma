// Data source for MongoDB
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User model with extended features
model User {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  email        String      @unique
  phone       String      @unique
  name         String?
  password     String   
    accounts      Account[]
  sessions      Session[]                   // Added for authentication
  role         Role        @default(USER)
  orders       Order[]                     // Relationship to track user orders
  createdAt    DateTime    @default(now()) // Timestamp for account creation
  updatedAt    DateTime    @updatedAt      // Auto-updated timestamp
}

// Category model for organizing products
model Category {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  name            String                      // Category name
  slug            String      @unique         // Unique slug for URL identification
  description     String?                     // Optional category description
                    // Banner image for the category
  thumbnailId      String?      @db.ObjectId   
  thumbnail      Media?     @relation(fields: [thumbnailId], references: [id], name: "categoryThumbnail") 
 bannerId      String?      @db.ObjectId   
 banner      Media?     @relation(fields: [bannerId], references: [id], name: "categoryBanner")
  // Self-referencing relation for subcategories
  subCategories   Category[] @relation("ParentChild")

  // Self-referencing relation for parent category
  parentCategory  Category?  @relation("ParentChild", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  parentCategoryId String?   @db.ObjectId   // Nullable field for subcategories

  isVariation     Boolean    @default(false)  // Flag to check if variations exist
  variations      VariationValue[]                        // Array of variations
  variationNames VariationName[]
  products        Product[]                   // One-to-many relationship with Product

  createdAt       DateTime   @default(now())  // Timestamp for category creation
  updatedAt       DateTime   @updatedAt      // Auto-updated timestamp
}

// Variation Model (Size, Color, etc.)
model VariationName {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  name   String  @unique   
  categoryId String? @db.ObjectId
  category   Category? @relation(fields: [categoryId], references: [id])            
  values VariationValue[] // Example: "Size", "Color"
  combinations Combination[]
}

// Variation Value Model (Specific options like XL, Red, etc.)
model VariationValue {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  variationId String  @db.ObjectId
  variation   VariationName @relation(fields: [variationId], references: [id])
  categoryId  String?  @db.ObjectId  // Can be nullable if the variation is global
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  value       String  // Example: "XL", "Red", "L"
  // Many-to-Many Relationship using Join Table
 
  combinations Combination[] // Many-to-Many Relationship using Join Table
}

model ProductCodeCounter{
    id  String @id @default(auto()) @map("_id") @db.ObjectId
    lastProductCode Int
}

model Media {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  name      String
  host      String
  categoryThumbnail Category[] @relation(name: "categoryThumbnail")
  categoryBanner Category[] @relation(name: "categoryBanner")
  // Reverse relations
  productsAsThumbnail Product[] 
  ProductVariationThumbnail ProductVariation[] 
  productGallery ProductGallery[]  // Explicit Many-to-Many Relation
  banner banner[]  // Explicit Many-to-Many Relation
  createdAt DateTime @default(now())
}

model Product {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  productCode    String? 
  title          String                        // Product title
  slug           String      @unique           // Unique slug for URL identification
  description    String?                        // Optional detailed description
  categoryId     String?      @db.ObjectId      // Foreign key for Category
  category       Category?    @relation(fields: [categoryId], references: [id]) // Relation to Category
  
  mainImage   String?
  imageGallery    String[]
  
  thumbnailId    String?    @db.ObjectId
  thumbnail      Media?     @relation(fields: [thumbnailId], references: [id])
  videoUrl String? // Optional video URL for the product
  gallery ProductGallery[]
  seoKeyWord     String?
  seoDescription String?
  isFeatured     Boolean?    @default(false)     // Indicates if the product is featured
  isActive       Boolean?    @default(true)      // Marks if the product is active
  hasVariations    Boolean? @default(false)           
      // Many-to-Many Relationship using Join Table 
  variations      ProductVariation[] 
  orders         OrderItem[]                     // One-to-many relationship with Order
  weight Float?
  dimensions String? // Optional dimensions for the product (e.g., "10x10x10 cm")
  createdAt      DateTime    @default(now())     // Timestamp for product creation
  updatedAt      DateTime    @updatedAt          // Auto-updated timestamp
}

model ProductGallery {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  productId  String @db.ObjectId
  mediaId    String @db.ObjectId

  product    Product @relation(fields: [productId], references: [id],onDelete: Cascade)
  media      Media @relation(fields: [mediaId], references: [id])

  createdAt DateTime @default(now())
}


model ProductVariation{
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  productId     String?      @db.ObjectId    // Foreign key for Category
  product       Product?    @relation(fields: [productId], references: [id] ,onDelete: Cascade) // Relation to Category
  sku          String
  stock       Float?
  regularPrice   Float?                         // Regular price of the product
  discountPrice  Float?                         // Optional discount price
  thumbnailId    String?    @db.ObjectId
  thumbnail      Media?     @relation(fields: [thumbnailId], references: [id])
  matcherId String
  
  combinations Combination[] // Many-to-Many Relationship using Join Table
  orders OrderItem[]
}

model Combination {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
 productVariationId String @db.ObjectId
  productVariation   ProductVariation @relation(fields: [productVariationId], references: [id], onDelete: Cascade)
 variationNameId String? @db.ObjectId
  variationName VariationName? @relation(fields: [variationNameId],references: [id])
  variationValueId String? @db.ObjectId
  variationValue VariationValue? @relation(fields: [variationValueId],references: [id])
  // Additional fields can be added as needed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
}




model Order {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNo        String @unique
  orderItems     OrderItem[] 
  userId         String?      @db.ObjectId    // Foreign key for User
  user           User?        @relation(fields: [userId], references: [id]) // Relation to User
  customerName   String
  phoneNumber    String
  email          String
  orderPrice     Float                       // Price of the product at the time of order
  deliveryCharge Float 
  city           String?    
  deliveryAddress String 
  paymentMethod   String?                    // Address for product delivery
  note            String?
  status         OrderStatus @default(PENDING) // Order status enumeration
  createdAt      DateTime    @default(now()) // Timestamp for order placement
  updatedAt      DateTime    @updatedAt      // Auto-updated timestamp
}

model OrderItem{
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String      @db.ObjectId    
  order           Order   @relation(fields: [orderId], references: [id],onDelete: Cascade) 
  orderNo        String
  orderItemNo    Int 
  productName    String
  sku            String
  price          Float
  quantity       Int // Foreign key for Product
  productId      String      @db.ObjectId   
  product      Product     @relation(fields: [productId], references: [id]) // Relation to Product
  combinations  String[]
  variationId   String @db.ObjectId
  variation     ProductVariation @relation(fields: [variationId], references: [id]) 
  status         OrderStatus @default(PENDING)
  createdAt      DateTime    @default(now()) // Timestamp for order placement
  updatedAt      DateTime    @updatedAt      // Auto-updated timestamp 

}
model orderCounter {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  lastOrderNumber Int
}



model siteSetting {
id              String @id @default(auto()) @map("_id") @db.ObjectId
name   String?
slogan  String?
logo   String?
phoneNumber1 String?
phoneNumber2 String?
adress1 String?
adress2 String?
googleMap String?
email String?
fbLink  String?
youTubeLink String?
createdAt      DateTime    @default(now()) // Timestamp for order placement
updatedAt      DateTime    @updatedAt      // Auto-updated timestamp 

}

model notice{
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  notice String?
  start   DateTime?
  end   DateTime?
  createdAt      DateTime    @default(now()) // Timestamp for order placement
  updatedAt      DateTime    @updatedAt      // Auto-updated timestamp 
}


model banner{
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  thumbnailId    String?    @db.ObjectId
  thumbnail      Media?     @relation(fields: [thumbnailId], references: [id])
  name String?
  createdAt      DateTime    @default(now()) // Timestamp for order placement
  updatedAt      DateTime    @updatedAt  
}
// Review and rating model for products


// Enumeration for order status
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  RETURNED
}

// Enumeration for user roles
enum Role {
  USER 
  ADMIN
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
}
 
model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}