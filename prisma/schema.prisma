// Data source for MongoDB
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum StoreDomainType {
  SUBDOMAIN
  CUSTOM
}

enum StoreDomainStatus {
  ACTIVE
  INACTIVE
}

model Store {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String          @unique
  status    StoreStatus     @default(ACTIVE)
  domains   StoreDomain[]
  members   StoreMember[]
  roles     StoreRole[]
  customers StoreCustomer[]
  categories Category[]
  variationNames VariationName[]
  productCodeCounters ProductCodeCounter[]
  media Media[]
  products Product[]
  orders Order[]
  counters Counter[]
  orderCounters OrderCounter[]
  shippings Shipping[]
  paymentGateways PaymentGateway[]
  courierProviders CourierProvider[]
  socialTrackingSettings SocialTrackingSetting[]
  payments Payment[]
  refunds Refund[]
  moneyAccounts MoneyAccount[]
  courierPickupPoints CourierPickupPoint[]
  siteSettings SiteSetting[]
  contentPages ContentPage[]
  notices Notice[]
  banners banner[]
  heroSlides HeroSlide[]
  suppliers Supplier[]
  purchaseOrders PurchaseOrder[]
  warehouses Warehouse[]
  goodsReceipts GoodsReceipt[]
  deliveries Delivery[]
  inventoryTransactions InventoryTransaction[]
  stocks Stock[]
  expenseCategories ExpenseCategory[]
  expenses Expense[]
  supplierPayments SupplierPayment[]
  moneyTransactions MoneyTransaction[]
  shareholders Shareholder[]
  journalEntries JournalEntry[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model StoreDomain {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  storeId    String            @db.ObjectId
  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  domain     String            @unique
  type       StoreDomainType
  isPrimary  Boolean           @default(false)
  isVerified Boolean           @default(false)
  status     StoreDomainStatus @default(ACTIVE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([storeId, status])
  @@index([storeId, isPrimary])
}

enum IdentityStatus {
  ACTIVE
  INACTIVE
}

model PlatformMember {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String
  normalizedEmail String         @unique
  phone           String?
  passwordHash    String
  roleId          String         @db.ObjectId
  role            PlatformRole   @relation(fields: [roleId], references: [id])
  status          IdentityStatus @default(ACTIVE)
  tokenVersion    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([roleId, status])
}

model PlatformRole {
  id          String                   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  code        String                   @unique
  description String?
  status      IdentityStatus           @default(ACTIVE)
  members     PlatformMember[]
  permissions PlatformRolePermission[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

model PlatformRolePermission {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  roleId    String       @db.ObjectId
  role      PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource  String
  action    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([roleId, resource, action])
}

model StoreMember {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  storeId         String         @db.ObjectId
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  email           String
  normalizedEmail String
  phone           String?
  passwordHash    String
  roleId          String         @db.ObjectId
  role            StoreRole      @relation(fields: [roleId], references: [id])
  status          IdentityStatus @default(ACTIVE)
  tokenVersion    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([storeId, normalizedEmail])
  @@index([storeId])
  @@index([roleId, status])
}

model StoreRole {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  storeId     String                @db.ObjectId
  store       Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  status      IdentityStatus        @default(ACTIVE)
  members     StoreMember[]
  permissions StoreRolePermission[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([storeId, code])
  @@index([storeId, status])
}

model StoreRolePermission {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  roleId    String    @db.ObjectId
  role      StoreRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource  String
  action    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([roleId, resource, action])
}

model StoreCustomer {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  storeId         String         @db.ObjectId
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  email           String
  normalizedEmail String
  phone           String?
  status          IdentityStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([storeId, normalizedEmail])
  @@index([storeId])
}

// User model with extended features
model User {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  email  String  @unique
  phone  String? @unique
  name   String?
  gender String?

  password     String
  accounts     Account[]
  sessions     Session[]
  roleId       String    @db.ObjectId
  role         Role      @relation(fields: [roleId], references: [id])
  tokenVersion Int       @default(0)
  orders       Order[] // Relationship to track user orders
  createdAt    DateTime? @default(now()) // Timestamp for account creation
  updatedAt    DateTime  @updatedAt // Auto-updated timestamp
}

model Role {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  name        String           @unique
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) // Timestamp for account creation
  updatedAt   DateTime         @updatedAt // Auto-updated timestamp
}

model Resource {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  key         String           @unique // user, product, order
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) // Timestamp for account creation
  updatedAt   DateTime         @updatedAt // Auto-updated timestamp
}

model Action {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  key         String           @unique // create, view, update, delete
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) // Timestamp for account creation
  updatedAt   DateTime         @updatedAt // Auto-updated timestamp
}

model RolePermission {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  roleId     String  @db.ObjectId
  resourceId String  @db.ObjectId
  actionId   String  @db.ObjectId
  allowed    Boolean @default(true)

  role      Role     @relation(fields: [roleId], references: [id])
  resource  Resource @relation(fields: [resourceId], references: [id])
  action    Action   @relation(fields: [actionId], references: [id])
  createdAt DateTime @default(now()) // Timestamp for account creation
  updatedAt DateTime @updatedAt // Auto-updated timestamp

  @@unique([roleId, resourceId, actionId])
}

// Category model for organizing products
model Category {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  storeId       String     @db.ObjectId
  store         Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String // Category name
  slug          String // Unique slug inside a Store
  description   String? // Optional category description
  // Banner image for the category
  thumbnailId   String?    @db.ObjectId
  thumbnail     Media?     @relation(fields: [thumbnailId], references: [id], name: "categoryThumbnail")
  bannerId      String?    @db.ObjectId
  banner        Media?     @relation(fields: [bannerId], references: [id], name: "categoryBanner")
  // Self-referencing relation for subcategories
  subCategories Category[] @relation("ParentChild")

  // Self-referencing relation for parent category
  parentCategory Category? @relation("ParentChild", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  parentCategoryId String? @db.ObjectId // Nullable field for subcategories

  isVariation    Boolean          @default(false) // Flag to check if variations exist
  variations     VariationValue[] // Array of variations
  variationNames VariationName[]
  products       Product[] // One-to-many relationship with Product
  fullPath       String?
  createdAt      DateTime         @default(now()) // Timestamp for category creation
  updatedAt      DateTime         @updatedAt // Auto-updated timestamp

  @@unique([storeId, slug])
  @@index([storeId, fullPath])
}

// Variation Model (Size, Color, etc.)
model VariationName {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  storeId      String           @db.ObjectId
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  categoryId   String?          @db.ObjectId
  category     Category?        @relation(fields: [categoryId], references: [id])
  values       VariationValue[] // Example: "Size", "Color"
  combinations Combination[]
  createdAt    DateTime?        @default(now()) // Timestamp for category creation
  updatedAt    DateTime?        @updatedAt // Auto-updated timestamp

  @@unique([storeId, name])
}

// Variation Value Model (Specific options like XL, Red, etc.)
model VariationValue {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  variationId String        @db.ObjectId
  variation   VariationName @relation(fields: [variationId], references: [id])
  categoryId  String?       @db.ObjectId // Can be nullable if the variation is global
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  value       String // Example: "XL", "Red", "L"
  // Many-to-Many Relationship using Join Table

  combinations Combination[] // Many-to-Many Relationship using Join Table
  createdAt    DateTime?     @default(now()) // Timestamp for category creation
  updatedAt    DateTime?     @updatedAt // Auto-updated timestamp
}

model ProductCodeCounter {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  storeId         String @db.ObjectId
  store           Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lastProductCode Int

  @@unique([storeId])
}

model Media {
  id                        String             @id @default(auto()) @map("_id") @db.ObjectId
  storeId                   String             @db.ObjectId
  store                     Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  url                       String
  name                      String
  host                      String
  categoryThumbnail         Category[]         @relation(name: "categoryThumbnail")
  categoryBanner            Category[]         @relation(name: "categoryBanner")
  // Reverse relations
  productsAsThumbnail       Product[]
  ProductVariationThumbnail ProductVariation[]
  productGallery            ProductGallery[] // Explicit Many-to-Many Relation
  banner                    banner[] // Explicit Many-to-Many Relation
  heroSlides                HeroSlide[]
  supplierDocuments         SupplierDocument[] // Explicit Many-to-Many Relation
  createdAt                 DateTime           @default(now())

  @@index([storeId, createdAt])
}

model Product {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  storeId      String    @db.ObjectId
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productCode  String?
  title        String // Product title
  slug         String // Unique slug inside a Store
  description  String? // Optional detailed description
  categoryId   String?   @db.ObjectId // Foreign key for Category
  category     Category? @relation(fields: [categoryId], references: [id]) // Relation to Category
  canonicalUrl String?

  thumbnailId          String?            @db.ObjectId
  thumbnail            Media?             @relation(fields: [thumbnailId], references: [id])
  videoUrl             String? // Optional video URL for the product
  videos               ProductVideo[]
  gallery              ProductGallery[]
  seoKeyWord           String?
  seoDescription       String?
  isFeatured           Boolean?           @default(false) // Indicates if the product is featured
  isActive             Boolean?           @default(true) // Marks if the product is active
  allowOutOfStockOrder Boolean            @default(false)
  status               ProductStatus?     @default(ACTIVE) // Product status enumeration
  hasVariations        Boolean?           @default(false)
  google_Category_id   String?
  gender               String?
  ageGroup             String?
  variations           ProductVariation[]
  orders               OrderItem[]
  searchText           String?
  Purchase             PurchaseItem[]
  createdAt            DateTime           @default(now()) // Timestamp for product creation
  updatedAt            DateTime           @updatedAt // Auto-updated timestamp

  @@unique([storeId, slug])
  @@index([storeId, productCode])
  @@index([storeId, searchText])
}

model ProductVideo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  header    String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductGallery {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  productId String @db.ObjectId
  mediaId   String @db.ObjectId

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id])

  createdAt DateTime @default(now())
}

model ProductVariation {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  productId     String?  @db.ObjectId // Foreign key for Category
  product       Product? @relation(fields: [productId], references: [id], onDelete: Cascade) // Relation to Category
  sku           String
  weight        Float?
  dimensions    String?
  regularPrice  Float? // Regular price of the product
  discountPrice Float? // Optional discount price
  thumbnailId   String?  @db.ObjectId
  thumbnail     Media?   @relation(fields: [thumbnailId], references: [id])
  matcherId     String

  combinations      Combination[] // Many-to-Many Relationship using Join Table
  orders            OrderItem[]
  purchases         PurchaseItem[]
  goodsReceiptItems GoodsReceiptItem[]
  transactions      InventoryTransaction[]
  stocks            Stock[]
  deliveryItems     DeliveryItem[]
}

model Combination {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  productVariationId String           @db.ObjectId
  productVariation   ProductVariation @relation(fields: [productVariationId], references: [id], onDelete: Cascade)
  variationNameId    String?          @db.ObjectId
  variationName      VariationName?   @relation(fields: [variationNameId], references: [id])
  variationValueId   String?          @db.ObjectId
  variationValue     VariationValue?  @relation(fields: [variationValueId], references: [id])
  orderItems         OrderItem[] // Relationship to OrderItem
  // Additional fields can be added as needed
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Order {
  id                        String           @id @default(auto()) @map("_id") @db.ObjectId
  storeId                   String           @db.ObjectId
  store                     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderNo                   String
  orderItems                OrderItem[]
  userId                    String?          @db.ObjectId // Foreign key for User
  user                      User?            @relation(fields: [userId], references: [id]) // Relation to User
  customerName              String
  phoneNumber               String
  email                     String
  orderPrice                Float // Price of the product at the time of order
  orderWeight               Float?
  adminDiscount             Float?
  adminNote                 String?
  taxAmount                 Float?
  cancelReason              String?
  cancelReasonType          String?
  deliveryCharge            Float
  city                      String?
  thana                     String?
  deliveryAddress           String
  deliveryArea              String?
  paymentMethod             PaymentMethod? // Address for product delivery
  paymentStatus             PaymentStatus    @default(UNPAID)
  paidAmount                Float            @default(0)
  dueAmount                 Float?
  note                      String?
  status                    OrderStatus      @default(PENDING) // Order status enumeration
  shipping                  Shipping?
  selectedPaymentGatewayId  String?          @db.ObjectId
  selectedPaymentGateway    PaymentGateway?  @relation("OrderPaymentGateway", fields: [selectedPaymentGatewayId], references: [id])
  selectedCourierProviderId String?          @db.ObjectId
  selectedCourierProvider   CourierProvider? @relation("OrderCourierProvider", fields: [selectedCourierProviderId], references: [id])
  timeline                  OrderTimeline[]
  payments                  Payment[]
  refunds                   Refund[]
  ledgers                   Ledger[]
  deliveries                Delivery[]
  fbc                       String?
  fbp                       String?
  gclid                     String?
  ttclid                    String
  userAgent                 String?
  ipAddress                 String?
  createdAt                 DateTime         @default(now()) // Timestamp for order placement
  updatedAt                 DateTime         @updatedAt // Auto-updated timestamp

  @@unique([storeId, orderNo])
  @@index([storeId, createdAt])
  @@index([selectedPaymentGatewayId])
  @@index([selectedCourierProviderId])
}

model OrderItem {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  orderId       String           @db.ObjectId
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNo       String
  orderItemNo   Int
  productName   String
  sku           String
  productCode   String?
  thumbnail     String?
  price         Float
  quantity      Int // Foreign key for Product
  productId     String           @db.ObjectId
  product       Product          @relation(fields: [productId], references: [id]) // Relation to Product
  combinations  String? // JSON string to store combination details
  combinationId String?          @db.ObjectId
  combination   Combination?     @relation(fields: [combinationId], references: [id])
  variationId   String           @db.ObjectId
  variation     ProductVariation @relation(fields: [variationId], references: [id])
  deliveryItems DeliveryItem[]
  status        OrderStatus      @default(PENDING)
  createdAt     DateTime         @default(now()) // Timestamp for order placement
  updatedAt     DateTime         @updatedAt // Auto-updated timestamp
}

model OrderCounter {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  storeId         String @db.ObjectId
  store           Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  idNo            Int
  lastOrderNumber Int

  @@unique([storeId, idNo])
}

model Counter {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  storeId String @db.ObjectId
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name String // SUPPLIER, PRODUCT, PURCHASE_ORDER

  prefix String?

  nextValue Int

  padding Int @default(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
}

model Shipping {
  id                     String           @id @default(auto()) @map("_id") @db.ObjectId
  storeId                String           @db.ObjectId
  store                  Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId                String           @unique @db.ObjectId
  order                  Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNo                String?
  cn                     String?
  courierName            String?
  courierProviderId      String?          @db.ObjectId
  courierProvider        CourierProvider? @relation(fields: [courierProviderId], references: [id])
  deliveryFee            Float?
  cod                    Float?
  codCollectedAt         DateTime?
  codCollectedAmount     Float?
  codCollectionReference String?
  estimatedDelivery      DateTime?
  createdAt              DateTime         @default(now()) // Timestamp for order placement
  updatedAt              DateTime         @updatedAt // Auto-updated timestamp

  @@index([storeId, cn])
  @@index([courierProviderId])
}

model PaymentGateway {
  id                   String        @id @default(auto()) @map("_id") @db.ObjectId
  storeId              String        @db.ObjectId
  store                Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                 String
  code                 String
  adapterKey           String        @default("MANUAL")
  isActive             Boolean       @default(false)
  sortOrder            Int           @default(0)
  moneyAccountId       String?       @db.ObjectId
  moneyAccount         MoneyAccount? @relation(fields: [moneyAccountId], references: [id])
  encryptedCredentials String?
  credentialVersion    Int           @default(1)
  credentialsUpdatedAt DateTime?
  nonSecretConfig      Json?
  orders               Order[]       @relation("OrderPaymentGateway")
  payments             Payment[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdBy            String?
  updatedBy            String?

  @@unique([storeId, code])
  @@index([storeId, isActive, sortOrder])
  @@index([moneyAccountId])
}

model CourierProvider {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  storeId              String               @db.ObjectId
  store                Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                 String
  code                 String
  adapterKey           String               @default("MANUAL")
  isActive             Boolean              @default(false)
  sortOrder            Int                  @default(0)
  moneyAccountId       String?              @db.ObjectId
  moneyAccount         MoneyAccount?        @relation(fields: [moneyAccountId], references: [id])
  encryptedCredentials String?
  credentialVersion    Int                  @default(1)
  credentialsUpdatedAt DateTime?
  nonSecretConfig      Json?
  orders               Order[]              @relation("OrderCourierProvider")
  shippings            Shipping[]
  pickupPoints         CourierPickupPoint[]
  payments             Payment[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  createdBy            String?
  updatedBy            String?

  @@unique([storeId, code])
  @@index([storeId, isActive, sortOrder])
  @@index([moneyAccountId])
}

// One database-backed configuration row controls browser pixels and
// server-side conversion APIs. Access tokens/secrets are stored together in
// encryptedSecrets; they are never returned with public storefront settings.
model SocialTrackingSetting {
  id                       String   @id @map("_id")
  storeId                  String   @db.ObjectId
  store                    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  facebookPixelId          String?
  googleTagId              String?
  googleAnalyticsId        String?
  tiktokPixelId            String?
  encryptedSecrets         String?
  secretsUpdatedAt         DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  createdBy                String?
  updatedBy                String?

  @@unique([storeId])
}

model OrderTimeline {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderNo String

  status OrderStatus

  title   String
  message String?

  location  String? // warehouse / city / courier hub
  createdBy String? // admin / system / courier

  createdAt DateTime @default(now())
}

enum PaymentMethod {
  ONLINE
  EMI
  COD
  CASH
  BANK
}

model Payment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  storeId String @db.ObjectId
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  transactionId     String?
  bankTransactionId String?

  gateway       String
  paymentMethod PaymentMethod?

  paymentGatewayId  String?          @db.ObjectId
  paymentGateway    PaymentGateway?  @relation(fields: [paymentGatewayId], references: [id])
  courierProviderId String?          @db.ObjectId
  courierProvider   CourierProvider? @relation(fields: [courierProviderId], references: [id])
  moneyAccountId    String?          @db.ObjectId
  moneyAccount      MoneyAccount?    @relation(fields: [moneyAccountId], references: [id])

  amount      Float
  storeAmount Float?
  status      PaymentStatus @default(PENDING)

  currency String  @default("BDT")
  cardType String?

  cardNo          String?
  cardIssuer      String?
  cardBrand       String?
  gatewayResponse Json?

  paidAt          DateTime?
  postedAt        DateTime?
  externalEventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds           Refund[]
  ledgers           Ledger[]
  moneyTransactions MoneyTransaction[]

  @@index([storeId, createdAt])
  @@index([storeId, transactionId])
  @@index([paymentGatewayId])
  @@index([courierProviderId])
  @@index([moneyAccountId])
  @@index([transactionId])
  @@index([externalEventId])
}

enum RefundStatus {
  PENDING
  APPROVED
  COMPLETED
  FAILED
  CANCELLED
}

model Refund {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  storeId String @db.ObjectId
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  paymentId      String?       @db.ObjectId
  payment        Payment?      @relation(fields: [paymentId], references: [id])
  moneyAccountId String?       @db.ObjectId
  moneyAccount   MoneyAccount? @relation(fields: [moneyAccountId], references: [id])

  amount Float

  reason    String?
  adminNote String?

  status RefundStatus @default(PENDING)

  externalReference String?

  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

