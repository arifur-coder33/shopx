  moneyAccount      MoneyAccount?      @relation(fields: [moneyAccountId], references: [id])
  moneyTransactions MoneyTransaction[]

  amount Float

  paymentMethod String

  reference String?

  paidAt DateTime

  createdAt DateTime @default(now())
  createdBy String?
  updatedBy String?

  @@index([storeId, paidAt])
  @@index([storeId, supplierId, paidAt])
  @@index([storeId, purchaseOrderId])
  @@index([storeId, moneyAccountId, paidAt])
