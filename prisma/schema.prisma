// Data source for MongoDB
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User model with extended features
model User {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  email        String      @unique
  phone       String      @unique
  name         String?
  password     String   
    accounts      Account[]
  sessions      Session[]                   // Added for authentication
  role         Role        @default(USER)
  orders       Order[]                     // Relationship to track user orders
  createdAt    DateTime    @default(now()) // Timestamp for account creation
  updatedAt    DateTime    @updatedAt      // Auto-updated timestamp
}

// Category model for organizing products
model Category {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  name        String                      // Category name
  slug        String      @unique         // Unique slug for URL identification
  description String?                     // Optional category description
  banner       String?                     // banner image for the category
  thumbnail   String?                     // Thumbnail image for previews
  subCategories Category[] @relation("ParentChild") // Self-referencing relation for subcategories
  parentCategory  Category?  @relation("ParentChild", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentCategoryId String? @db.ObjectId   // Nullable field for subcategories
  isVariation Boolean    @default(false)  // Flag to check if variations exist
  variations  VariationValue[]                       // Array of variations
  
  products    Product[]                   // One-to-many relationship with Product
  createdAt   DateTime    @default(now()) // Timestamp for category creation
  updatedAt   DateTime    @updatedAt      // Auto-updated timestamp
}

// Variation Model (Size, Color, etc.)
model Variation {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  name   String  @unique               // Example: "Size", "Color"
  values VariationValue[]
}

// Variation Value Model (Specific options like XL, Red, etc.)
model VariationValue {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  variationId String  @db.ObjectId
  variation   Variation @relation(fields: [variationId], references: [id])
  categoryId  String?  @db.ObjectId  // Can be nullable if the variation is global
  category       Category?    @relation(fields: [categoryId], references: [id])
  value       String[]   // Example: "XL", "Red", "L"
  image       String?
  
}

model ProductCodeCounter{
    id  String @id @default(auto()) @map("_id") @db.ObjectId
    lastProductCode Int
}

// Product model with extended features
model Product {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  productCode    String?  @unique   
  title          String                       // Product title
  slug           String      @unique         // Unique slug for URL identification
  description    String?                     // Optional detailed description
  categoryId     String?      @db.ObjectId    // Foreign key for Category
  category       Category?    @relation(fields: [categoryId], references: [id]) // Relation to Category
  regularPrice   Float                       // Regular price of the product
  discountPrice  Float?                      // Optional discount price
  stockQuantity  Int         @default(0)    // Stock quantity for inventory tracking
  mainImage     String
  seoKeyWord     String?
  seoDescription String?
  imageGallery   String[]                  // Array of image URLs
  isFeatured     Boolean?    @default(false) // Indicates if the product is featured
  isActive       Boolean?     @default(true)  // Marks if the product is active
  hasVariations    Boolean? @default(false)  
  variations     ProductVariation[]
  variationAttrivutes VariationValue[]   // here i want to relation with VariationValue
  insideDhaka    Float?                      // Optional delivery charge inside Dhaka
  outSideDhaka   Float?                      // Optional delivery charge outside Dhaka
  weight         Float?  
              // Product weight for shipping purposes
  orders         OrderItem[]                    // One-to-many relationship with Order
  createdAt      DateTime    @default(now()) // Timestamp for product creation
  updatedAt      DateTime    @updatedAt      // Auto-updated timestamp
}
model ProductVariation{
    id             String      @id @default(auto()) @map("_id") @db.ObjectId
    productId         String?      @db.ObjectId    // Foreign key for User
    product           Product?        @relation(fields: [productId], references: [id]) // Relation to User
    variations       Json?   /// {{color:red,size:xl,id:red-xl}}
    weight          Float?
    price           Float?
    stockQty        Float?
}

// Order model with extended features
model Order {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNo        String @unique
  orderItems     OrderItem[] 
  userId         String?      @db.ObjectId    // Foreign key for User
  user           User?        @relation(fields: [userId], references: [id]) // Relation to User
  customerName   String
  phoneNumber    String
  orderPrice     Float                       // Price of the product at the time of order
  deliveryCharge Float     
  deliveryArea   String                  // Delivery charge for the order
  deliveryAddress String 
  paymentMethod   String?                    // Address for product delivery
  status         OrderStatus @default(PENDING) // Order status enumeration
  createdAt      DateTime    @default(now()) // Timestamp for order placement
  updatedAt      DateTime    @updatedAt      // Auto-updated timestamp
}

model OrderItem{
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String      @db.ObjectId    
  order           Order   @relation(fields: [orderId], references: [id],onDelete: Cascade) 
  orderNo        String
  orderItemNo    Int 
  productName    String
  price          Float
  quantity       Int // Foreign key for Product
  productColor   String?
  productSize    String?
  productId      String      @db.ObjectId   
  product      Product     @relation(fields: [productId], references: [id]) // Relation to Product
  status         OrderStatus @default(PENDING)
  createdAt      DateTime    @default(now()) // Timestamp for order placement
  updatedAt      DateTime    @updatedAt      // Auto-updated timestamp 

}
model orderCounter {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  lastOrderNumber Int
}

model siteSetting {
id              String @id @default(auto()) @map("_id") @db.ObjectId
name   String?
slogan  String?
logo   String?
phoneNumber1 String?
phoneNumber2 String?
adress1 String?
adress2 String?
googleMap String?
email String?
fbLink  String?
youTubeLink String?
createdAt      DateTime    @default(now()) // Timestamp for order placement
updatedAt      DateTime    @updatedAt      // Auto-updated timestamp 

}

model notice{
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  notice String?
  start   DateTime?
  end   DateTime?
  createdAt      DateTime    @default(now()) // Timestamp for order placement
  updatedAt      DateTime    @updatedAt      // Auto-updated timestamp 
}


model banner{
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  image String?
  name String?
  createdAt      DateTime    @default(now()) // Timestamp for order placement
  updatedAt      DateTime    @updatedAt  
}
// Review and rating model for products


// Enumeration for order status
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  RETURNED
}

// Enumeration for user roles
enum Role {
  USER 
  ADMIN
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
}
 
model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}