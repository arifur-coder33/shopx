model FinancialAccount {
  id        String               @id @default(auto()) @map("_id") @db.ObjectId
  code      String               @unique
  name      String
  type      FinancialAccountType
  isActive  Boolean              @default(true)
  lines     JournalLine[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([type, isActive])
}

model MoneyAccount {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  storeId              String             @db.ObjectId
  store                Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                 String
  type                 MoneyAccountType
  accountNumber        String?
  balance              Float              @default(0)
  isActive             Boolean            @default(true)
  incomingTransactions MoneyTransaction[] @relation("MoneyTransactionTo")
  outgoingTransactions MoneyTransaction[] @relation("MoneyTransactionFrom")
  supplierPayments     SupplierPayment[]
  expenses             Expense[]
  paymentGateways      PaymentGateway[]
  courierProviders     CourierProvider[]
  payments             Payment[]
  refunds              Refund[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  createdBy            String?
  updatedBy            String?

  @@index([storeId, type, isActive])
}

enum MoneyAccountType {
  CASH
  BANK
  MOBILE_FINANCIAL
  PAYMENT_GATEWAY
  COURIER
}

model MoneyTransaction {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  storeId           String               @db.ObjectId
  store              Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transactionNo     String
  type              MoneyTransactionType
  amount            Float
  fromAccountId     String?              @db.ObjectId
  fromAccount       MoneyAccount?        @relation("MoneyTransactionFrom", fields: [fromAccountId], references: [id])
  toAccountId       String?              @db.ObjectId
  toAccount         MoneyAccount?        @relation("MoneyTransactionTo", fields: [toAccountId], references: [id])
  shareholderId     String?              @db.ObjectId
  shareholder       Shareholder?         @relation(fields: [shareholderId], references: [id])
  supplierPaymentId String?              @db.ObjectId
  supplierPayment   SupplierPayment?     @relation(fields: [supplierPaymentId], references: [id])
  expenseId         String?              @db.ObjectId
  expense           Expense?             @relation(fields: [expenseId], references: [id])
  paymentId         String?              @db.ObjectId
  payment           Payment?             @relation(fields: [paymentId], references: [id])
  refundId          String?              @db.ObjectId
  refund            Refund?              @relation(fields: [refundId], references: [id])
  idempotencyKey    String?
  reference         String?
  note              String?
  transactionDate   DateTime             @default(now())
  createdAt         DateTime             @default(now())
  createdBy         String?

  @@unique([storeId, transactionNo])
  @@index([storeId, transactionDate])
  @@index([storeId, fromAccountId, transactionDate])
  @@index([storeId, toAccountId, transactionDate])
  @@index([shareholderId, transactionDate])
  @@index([supplierPaymentId])
  @@index([expenseId])
  @@index([paymentId])
  @@index([refundId])
  @@index([idempotencyKey])
}

model Shareholder {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  storeId         String             @db.ObjectId
