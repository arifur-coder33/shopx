@reference "tailwindcss";

@import "tailwindcss";

:root {
  color-scheme: light;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #f7f5ef;
  color: #18202f;
}

button,
input,
select,
textarea {
  font: inherit;
}

.ledger-grid {
  background-image:
    linear-gradient(rgba(24, 32, 47, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(24, 32, 47, 0.045) 1px, transparent 1px);
  background-size: 28px 28px;
}

/* .focus-ring {
  @apply focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-gray-100;
} */

@layer components {
  .focus-ring {
    @apply focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-gray-100;
  }
}
